# Copy to .env.local (gitignored) and fill in.

# google | openai | mock   — "mock" runs a scripted model: no key, no network, deterministic.
LLM_PROVIDER=google

# Key for the provider you picked (only that one is needed).
#   google: free key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Optional. Defaults: google → gemini-2.5-flash, openai → gpt-4.1-mini.
# Must support tool calling + structured outputs.
LLM_MODEL=

# SQLite file for messages, profile and conflicts (created on first run).
DATABASE_PATH=data/profile.db
