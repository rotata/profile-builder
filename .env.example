# Copy to .env.local (gitignored) and fill in.

# openai | mock   — "mock" runs a scripted model: no key, no network, deterministic.
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Any OpenAI chat model with tool calling + structured outputs.
LLM_MODEL=gpt-4.1-mini

# SQLite file for messages, profile and conflicts (created on first run).
DATABASE_PATH=data/profile.db
